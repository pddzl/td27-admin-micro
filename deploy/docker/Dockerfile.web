# syntax=docker/dockerfile:1
# Node-local web image (SPA on nginx, port 8500; proxies /api/* to the
# gateway). Build context is web/ — package.json lives there:
#
#   make image-web          # from the repo root (passes mirror args)
#   # equivalently:
#   docker build -f deploy/docker/Dockerfile.web -t localhost/td27-web:TAG web/
#
# Base images, apk mirror and npm registry are overridable — defaults are
# passed by the Makefile.
ARG NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
ARG RUN_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine

# --- Stage 1: build the SPA -------------------------------------------------
FROM ${NODE_IMAGE} AS builder

WORKDIR /web

# Enable pnpm via corepack (comes with Node); registry mirror for CN networks.
ARG NPM_REGISTRY=https://registry.npmmirror.com
RUN corepack enable && corepack prepare pnpm@9 --activate

# Copy dependency files first (better layer caching)
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --registry=${NPM_REGISTRY}

# Copy source and build
COPY . .
RUN pnpm build

# --- Stage 2: runtime -------------------------------------------------------
FROM ${RUN_IMAGE}

ARG APK_MIRROR=mirrors.aliyun.com
RUN if [ -n "$APK_MIRROR" ]; then \
            sed -i "s|dl-cdn.alpinelinux.org|$APK_MIRROR|g" /etc/apk/repositories; \
    fi && \
    addgroup -g 1000 -S td27 && adduser -u 1000 -S td27 -G td27

LABEL maintainer="pddzl5@foxmail.com"

COPY ./nginx/default.conf /etc/nginx/conf.d/default.template
COPY --from=builder /web/dist /usr/share/nginx/html/dist

RUN chown -R td27:td27 /usr/share/nginx/html/dist

# Healthcheck for nginx (busybox wget syntax)
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:8500/ > /dev/null || exit 1

EXPOSE 8500

CMD ["/bin/sh", "-c", "envsubst '$$BACKEND' < /etc/nginx/conf.d/default.template > /etc/nginx/conf.d/default.conf && exec nginx -g 'daemon off;'"]
