# syntax=docker/dockerfile:1
# Node-local image build (no registry): built on the k8s node with podman/
# docker, imported into containerd via the root Makefile (make image-import).
#
# Base images and mirrors are overridable for CN vs unrestricted networks —
# defaults are passed by the Makefile (see Dockerfile.basis header).
ARG GO_IMAGE=docker.m.daocloud.io/library/golang:1.26-alpine
ARG RUN_IMAGE=docker.m.daocloud.io/library/alpine:3.21

# --- Stage 1: compile -------------------------------------------------------
FROM ${GO_IMAGE} AS builder

# Go module proxy must be set INSIDE the container; host `go env -w` does not
# apply here. GONOSUMCHECK/GOFLAGS mirror the repo convention (AGENTS.md);
# CGO off since pgx is pure Go.
ARG GOPROXY=https://goproxy.cn,direct
ENV GOPROXY=${GOPROXY} \
    CGO_ENABLED=0 \
    GOFLAGS=-mod=mod \
    GONOSUMCHECK='*' \
    GONOSUMDB='*'

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build -trimpath -ldflags="-s -w" -o /out/gateway ./api/gateway/gateway.go

# --- Stage 2: runtime -------------------------------------------------------
FROM ${RUN_IMAGE}

# Config is NOT baked in — mounted from the gateway-config Secret at /etc/td27.
ARG APK_MIRROR=mirrors.aliyun.com
RUN if [ -n "$APK_MIRROR" ]; then \
            sed -i "s|dl-cdn.alpinelinux.org|$APK_MIRROR|g" /etc/apk/repositories; \
    fi && \
    apk add --no-cache ca-certificates tzdata && \
    addgroup -g 1000 -S td27 && adduser -u 1000 -S td27 -G td27

WORKDIR /app
COPY --from=builder /out/gateway /app/gateway
RUN chown -R td27:td27 /app

USER td27

EXPOSE 8888

ENTRYPOINT ["/app/gateway"]
CMD ["-f", "/etc/td27/gateway.yaml"]
